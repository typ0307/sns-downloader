# CORS origins (comma-separated) when the frontend calls the API directly
# CORS_ORIGINS=http://localhost:3000

# Directory where downloaded media is stored
# STORAGE_DIR=data

# Max size (bytes) for an uploaded cookies.txt
# MAX_UPLOAD_BYTES=1048576

# Rate limit for /api/extract (slowapi syntax)
# RATE_LIMIT=10/minute

# Browser to read login cookies from for private/age-restricted content and
# Instagram stories. Supported values: chrome, chromium, edge, firefox, safari,
# brave, opera, vivaldi, whale (and mobile variants). The browser must be on the
# same machine as the backend and logged in. Leave empty to require cookies.txt.
# COOKIES_FROM_BROWSER=chrome
